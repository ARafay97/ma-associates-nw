# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Admin login for /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Long random string used to sign the admin login cookie (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional: where bookings are saved. Defaults to ./data/bookings.json
# BOOKINGS_FILE=/var/data/ma-associates/bookings.json
